{
  "name": "Atlas Analytics Intendencias",
  "dataColors": [
    "#29A3F0",
    "#9B4DFF",
    "#FF6FB5",
    "#2FC4A6",
    "#F5C518",
    "#E94F4F",
    "#C40BFF",
    "#FF8A3D",
    "#7E57FF",
    "#3DDC97",
    "#FFB547",
    "#4DD0E1"
  ],
  "background": "#12042E",
  "foreground": "#F2EBFA",
  "tableAccent": "#C40BFF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#F2EBFA",
      "fontSize": 11
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#DCD2EA",
      "fontSize": 9
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#F2EBFA",
      "fontSize": 22
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#12042E"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0B0220"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1B0A3D"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2E1A57"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 70,
            "position": "Outer"
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2EBFA"
              }
            },
            "fontSize": 11
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#1B0A3D"
              }
            },
            "foreground": {
              "solid": {
                "color": "#A08FC2"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A08FC2"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2E1A57"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A08FC2"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#2E1A57"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#DCD2EA"
              }
            }
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#F2EBFA"
              }
            },
            "fontSize": 11
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#A08FC2"
              }
            },
            "fontSize": 8
          }
        ],
        "card": [
          {
            "barShow": true,
            "barColor": {
              "solid": {
                "color": "#C40BFF"
              }
            }
          }
        ]
      }
    }
  }
}