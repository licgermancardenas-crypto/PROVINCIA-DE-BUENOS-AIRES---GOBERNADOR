	partition fact_votos = m
		mode: import
		source =
				let
				    Origen_fact_votos = Csv.Document(File.Contents(CarpetaDatos & "fact_votos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Enc_fact_votos = Table.PromoteHeaders(Origen_fact_votos, [PromoteAllScalars=true]),
