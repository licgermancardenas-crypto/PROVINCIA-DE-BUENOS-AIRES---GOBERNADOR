	partition fact_participacion = m
		mode: import
		source =
				let
				    Origen_voto_resultados = Csv.Document(File.Contents(CarpetaDatos & "voto_resultados.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Enc_voto_resultados = Table.PromoteHeaders(Origen_voto_resultados, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Enc_voto_resultados, {{"eleccion", type text}, {"cod_indec", type text}, {"votos_positivos", Int64.Type}, {"electores", type number}, {"participacion", type number}, {"ganador", type text}, {"margen", type number}, {"ganador_nombre", type text}, {"pct_peronismo", type number}, {"rango_peronismo", type text}, {"rango_participacion", type text}, {"competencia", type text}, {"orden_rango_peronismo", Int64.Type}, {"orden_rango_participacion", type number}, {"orden_competencia", Int64.Type}, {"clave", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
