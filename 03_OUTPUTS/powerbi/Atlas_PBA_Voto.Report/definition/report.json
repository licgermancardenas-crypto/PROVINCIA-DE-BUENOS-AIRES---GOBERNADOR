{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/report/1.2.0/schema.json",
  "themeCollection": {
    "customTheme": {
      "name": "AtlasAnalytics.json",
      "reportVersionAtImport": "5.55",
      "type": "RegisteredResources"
    }
  },
  "layoutOptimization": "None",
  "resourcePackages": [
    {
      "name": "RegisteredResources",
      "type": "RegisteredResources",
      "items": [
        {
          "name": "AtlasAnalytics.json",
          "path": "AtlasAnalytics.json",
          "type": "CustomTheme"
        },
        {
          "name": "pba_municipios.json",
          "path": "pba_municipios.json",
          "type": "ShapeMap"
        }
      ]
    }
  ],
  "settings": {
    "useStylableVisualContainerHeader": true,
    "defaultDrillFilterOtherVisuals": true,
    "allowChangeFilterTypes": true,
    "useEnhancedTooltips": true
  }
}