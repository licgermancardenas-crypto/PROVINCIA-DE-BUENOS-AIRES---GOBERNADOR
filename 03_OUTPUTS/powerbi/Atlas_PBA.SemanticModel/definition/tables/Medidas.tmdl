table Medidas
	lineageTag: 4865394e-b59c-529b-80ff-ed944f2bbd45

	measure 'Elección activa' = SELECTEDVALUE ( dim_eleccion[eleccion], "D2025" )
		displayFolder: Elección
		lineageTag: 63d69e4c-ce34-5ae7-b4a0-76d009d08801

	measure 'Elección seleccionada' = SELECTEDVALUE ( dim_eleccion[rotulo], "Diputados nacionales 2025" )
		displayFolder: Elección
		lineageTag: 6303df76-00fd-555a-8068-4a8a2add11bf

	measure Votos = IF ( HASONEVALUE ( dim_eleccion[eleccion] ), SUM ( fact_votos[votos] ), CALCULATE ( SUM ( fact_votos[votos] ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: Votación
		lineageTag: 31585016-b8a4-560b-b723-74349c23616f

	measure '% Voto' = DIVIDE ( [Votos], CALCULATE ( [Votos], REMOVEFILTERS ( dim_espacio ) ) )
		formatString: 0.0%
		displayFolder: Votación
		lineageTag: fd4d1d31-ecb8-5be0-abcd-fba9054a10f4

	measure '% Peronismo' = CALCULATE ( [% Voto], dim_espacio[espacio] = "PERONISMO" )
		formatString: 0.0%
		displayFolder: Votación
		lineageTag: e13c565e-9007-5b38-918a-11bc8569ccd4

	measure '% Derecha' = CALCULATE ( [% Voto], dim_espacio[espacio] IN { "LLA", "LLA_PRO", "PRO_JXC" } )
		formatString: 0.0%
		displayFolder: Votación
		lineageTag: 6721b63f-7a14-5ada-93f0-799639dce1e9

	measure Ganador =
			VAR t = ADDCOLUMNS ( VALUES ( dim_espacio[espacio_nombre] ), "@v", [Votos] )
			RETURN MAXX ( TOPN ( 1, t, [@v], DESC ), dim_espacio[espacio_nombre] )
		displayFolder: Votación
		lineageTag: 072b9336-b8db-5d13-830d-433085636813

	measure '% Ganador' = MAXX ( VALUES ( dim_espacio[espacio] ), [% Voto] )
		formatString: 0.0%
		displayFolder: Votación
		lineageTag: 1ea9f571-a97d-51a2-8ace-76c80e057cad

	measure 'Margen (pts)' =
			VAR t = ADDCOLUMNS ( VALUES ( dim_espacio[espacio] ), "@p", [% Voto] )
			VAR p1 = MAXX ( t, [@p] )
			VAR p2 = MAXX ( FILTER ( t, [@p] < p1 ), [@p] )
			RETURN ( p1 - p2 ) * 100
		formatString: 0.0
		displayFolder: Votación
		lineageTag: 4f1118de-12e1-548a-965b-56afb5d7a04b

	measure Electores = IF ( HASONEVALUE ( dim_eleccion[eleccion] ), SUM ( fact_participacion[electores] ), CALCULATE ( SUM ( fact_participacion[electores] ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: Participación
		lineageTag: ee7cbb64-663f-5911-9efd-c9668316747c

	measure Votantes =
			VAR v = SUMX ( fact_participacion, fact_participacion[electores] * fact_participacion[participacion] / 100 )
			RETURN IF ( HASONEVALUE ( dim_eleccion[eleccion] ), v, CALCULATE ( SUMX ( fact_participacion, fact_participacion[electores] * fact_participacion[participacion] / 100 ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: Participación
		lineageTag: 5c5154f3-0706-59c7-9ced-55707f18dd59

	measure Participación = DIVIDE ( [Votantes], [Electores] )
		formatString: 0.0%
		displayFolder: Participación
		lineageTag: 96ed7ae4-9392-57ee-acd9-3e9a5699ade1

	measure Municipios = DISTINCTCOUNT ( dim_municipio[cod_indec] )
		formatString: #,0
		displayFolder: Territorio
		lineageTag: 7bf22414-bf08-5714-8655-5e06e87f5691

	measure Población = SUM ( dim_municipio[pob] )
		formatString: #,0
		displayFolder: Territorio
		lineageTag: fabc7818-3193-570b-aba2-30964e1893c6

	measure '% de la Provincia' = DIVIDE ( [Población], CALCULATE ( [Población], REMOVEFILTERS ( dim_municipio ) ) )
		formatString: 0.0%
		displayFolder: Territorio
		lineageTag: dfd7828e-39c2-5efa-ac00-d9785c17d53e

	measure 'Hogares con NBI %' = DIVIDE ( SUMX ( dim_municipio, dim_municipio[hogares] * dim_municipio[nbi] / 100 ), SUM ( dim_municipio[hogares] ) )
		formatString: 0.0%
		displayFolder: Censo
		lineageTag: 4f31d24c-7332-5e06-907e-bde8f680f962

	measure 'Hogares en barrios populares %' = DIVIDE ( SUMX ( dim_municipio, dim_municipio[hogares] * dim_municipio[pct_barrio_popular] / 100 ), SUM ( dim_municipio[hogares] ) )
		formatString: 0.0%
		displayFolder: Censo
		lineageTag: 9689393b-ca69-5b1c-803f-8b8e93ac92dd

	measure 'Universitarios %' = DIVIDE ( SUMX ( dim_municipio, dim_municipio[pob] * dim_municipio[pct_univ] / 100 ), [Población] )
		formatString: 0.0%
		displayFolder: Censo
		lineageTag: dee2f9c3-9f3e-5cd7-9635-8f24f173c8ea

	measure Escuelas = SUM ( dim_municipio[escuelas] )
		formatString: #,0
		displayFolder: Censo
		lineageTag: 30696b9c-95a5-559a-9e96-d8e25d616c20

	measure 'Transferencias por habitante' = DIVIDE ( SUMX ( dim_municipio, dim_municipio[transferencias_hab] * dim_municipio[pob] ), [Población] )
		formatString: $ #,0
		displayFolder: Gestión
		lineageTag: 1016dd20-db19-53fa-8edc-cadd6ea871ca

	measure Intendente = SELECTEDVALUE ( dim_municipio[intendente], "Elegí un municipio" )
		displayFolder: Ficha
		lineageTag: d19deaaf-f657-5236-9330-d89f3e31b93b

	measure Municipio = SELECTEDVALUE ( dim_municipio[municipio], "Provincia de Buenos Aires" )
		displayFolder: Ficha
		lineageTag: 55ed3472-006b-5fb0-ac38-a769e931af13

	measure 'Foto intendente' = SELECTEDVALUE ( dim_municipio[foto_url] )
		dataCategory: ImageUrl
		displayFolder: Ficha
		lineageTag: 46aae8a9-a9ca-5bb5-b179-7af6b42cc0ac

	measure 'Título elección' = "Resultado · " & [Elección seleccionada]
		displayFolder: Elección
		lineageTag: 180238f5-d486-52f0-b023-6c7ef3fe5e34

	measure 'P(peronismo) 2027' = AVERAGE ( fact_motor_2027[p_gana_peronismo] )
		formatString: 0%
		displayFolder: 2027
		lineageTag: 6468c1e4-26b4-5508-ae59-7d570baeb5cb

	measure 'Municipios peronistas esperados' = SUM ( fact_motor_2027[p_gana_peronismo] )
		formatString: #,0.0
		displayFolder: 2027
		lineageTag: 5ac9d2d3-3bc8-58b4-9f92-56c5d5ce9e5d

	measure 'Municipios en disputa' = COUNTROWS ( FILTER ( fact_motor_2027, fact_motor_2027[p_gana_peronismo] >= 0.2 && fact_motor_2027[p_gana_peronismo] <= 0.8 ) )
		formatString: #,0
		displayFolder: 2027
		lineageTag: 9cc15b54-593a-5dee-b069-34d3659330d9

	measure 'Sucesión abierta' = CALCULATE ( [Municipios], dim_municipio[escenario_2027] = "Sucesión abierta" )
		formatString: #,0
		displayFolder: Intendencias
		lineageTag: bfe06019-7f5a-503e-a98a-bb060afeef98

	measure 'Reelección posible' = CALCULATE ( [Municipios], dim_municipio[escenario_2027] = "Reelección posible" )
		formatString: #,0
		displayFolder: Intendencias
		lineageTag: ce688b06-77d2-58b8-aed6-c2cc157526a4

	measure 'Zona gris' = CALCULATE ( [Municipios], dim_municipio[escenario_2027] = "Zona gris (judicial)" )
		formatString: #,0
		displayFolder: Intendencias
		lineageTag: 3b44152e-7e8b-5dbc-b957-c6ea53534bd3

	measure '% sucesión abierta' = DIVIDE ( [Sucesión abierta], [Municipios] )
		formatString: 0%
		displayFolder: Intendencias
		lineageTag: 9fe7d6a0-edbe-5117-a5dd-b553a8c32363

	measure Prospectos = COUNTROWS ( prospectos )
		formatString: #,0
		displayFolder: CRM
		lineageTag: 957cd6c7-65d3-570a-8a8a-d2842bdbaf62

	measure Rivales = CALCULATE ( [Prospectos], prospectos[rol] = "Oposición / rival" )
		formatString: #,0
		displayFolder: CRM
		lineageTag: ade4b916-704a-5524-8990-5867a08ba4e3

	measure 'Prioridad alta' = CALCULATE ( [Prospectos], prospectos[prioridad] = "Alta" )
		formatString: #,0
		displayFolder: CRM
		lineageTag: fe529800-2bf0-5ec4-aa71-1f515ea6a2e5

	measure Contactados = CALCULATE ( [Prospectos], prospectos[estado] <> "Pendiente" )
		formatString: #,0
		displayFolder: CRM
		lineageTag: 019acffd-0c2c-5c2c-932a-3883a83d8853

	measure '% contactados' = DIVIDE ( [Contactados], [Prospectos] )
		formatString: 0%
		displayFolder: CRM
		lineageTag: 7679b8f3-5cd5-5e39-a51b-2bbf43fcd3e5

	measure Noticias = COUNTROWS ( noticias )
		formatString: #,0
		displayFolder: Noticias
		lineageTag: 3782eb55-2663-53fb-97ac-2f63656c16b1

	measure 'Última noticia' = MAX ( noticias[fecha] )
		formatString: dd/mm/yyyy
		displayFolder: Noticias
		lineageTag: b22cb25f-0eeb-5023-bac9-e4dd59c6dbf7

	measure 'Mapa Provincia' =
			VAR capa = SELECTEDVALUE ( capa_mapa[capa], "Espacio 2026" )
			VAR el = [Elección activa]
			VAR vis = VALUES ( dim_municipio[cod_indec] )
			VAR n = COUNTROWS ( vis )
			VAR total = COUNTROWS ( ALL ( dim_municipio ) )
			VAR cuerpo =
			    CONCATENATEX (
			        FILTER ( ALL ( dim_municipio ), dim_municipio[svg_prov] <> "" ),
			        VAR c = dim_municipio[cod_indec]
			        VAR p = CALCULATE ( [P(peronismo) 2027] )
			        VAR v = CALCULATE ( [% Peronismo] )
			        VAR g = CALCULATE ( MAX ( fact_participacion[ganador] ), dim_eleccion[eleccion] = el )
			        VAR relleno =
			            SWITCH (
			                capa,
			                "Espacio 2026", dim_municipio[color_espacio_2026],
			                "Escenario 2027", dim_municipio[color_escenario],
			                "Concejales 2025", dim_municipio[color_concejales],
			                "Fuerza del intendente", dim_municipio[color_fuerza],
			                "Oportunidad", dim_municipio[color_oportunidad],
			                "Hogares con NBI", dim_municipio[color_nbi],
			                "Barrios populares", dim_municipio[color_bp],
			                "Ganador de la elección", COALESCE ( LOOKUPVALUE ( dim_espacio[color], dim_espacio[espacio], g ), "#3A3350" ),
			                "P(peronismo) 2027", SWITCH ( TRUE (), ISBLANK ( p ), "#3A3350", p >= 0.9, "#29A3F0", p >= 0.6, "#2178B8", p >= 0.4, "#C40BFF", p >= 0.1, "#5B3FA8", "#7E57FF" ),
			                "% Peronismo", SWITCH ( TRUE (), ISBLANK ( v ), "#3A3350", v >= 0.55, "#0B6FB8", v >= 0.45, "#29A3F0", v >= 0.35, "#7CC4F2", v >= 0.25, "#3A4E78", "#2A2350" ),
			                "#3A3350"
			            )
			        RETURN "<path fill='" & IF ( c IN vis, relleno, "#241448" ) & "' d='" & dim_municipio[svg_prov] & "'/>",
			        ""
			    )
			VAR resalte =
			    IF (
			        n = 1 && n < total,
			        "<path fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linejoin='round' d='" & CALCULATE ( MAX ( dim_municipio[svg_prov] ) ) & "'/>"
			    )
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 854'><g stroke='#12042E' stroke-width='0.7' stroke-linejoin='round'>" & cuerpo & "</g>" & resalte & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( svg, "#", "%23" )
		dataCategory: ImageUrl
		displayFolder: Mapa
		lineageTag: bcc392c1-94c8-5703-8c43-4b155be13969

	measure 'Mapa Conurbano' =
			VAR capa = SELECTEDVALUE ( capa_mapa[capa], "Espacio 2026" )
			VAR el = [Elección activa]
			VAR vis = VALUES ( dim_municipio[cod_indec] )
			VAR n = COUNTROWS ( vis )
			VAR total = COUNTROWS ( ALL ( dim_municipio ) )
			VAR cuerpo =
			    CONCATENATEX (
			        FILTER ( ALL ( dim_municipio ), dim_municipio[svg_conu] <> "" ),
			        VAR c = dim_municipio[cod_indec]
			        VAR p = CALCULATE ( [P(peronismo) 2027] )
			        VAR v = CALCULATE ( [% Peronismo] )
			        VAR g = CALCULATE ( MAX ( fact_participacion[ganador] ), dim_eleccion[eleccion] = el )
			        VAR relleno =
			            SWITCH (
			                capa,
			                "Espacio 2026", dim_municipio[color_espacio_2026],
			                "Escenario 2027", dim_municipio[color_escenario],
			                "Concejales 2025", dim_municipio[color_concejales],
			                "Fuerza del intendente", dim_municipio[color_fuerza],
			                "Oportunidad", dim_municipio[color_oportunidad],
			                "Hogares con NBI", dim_municipio[color_nbi],
			                "Barrios populares", dim_municipio[color_bp],
			                "Ganador de la elección", COALESCE ( LOOKUPVALUE ( dim_espacio[color], dim_espacio[espacio], g ), "#3A3350" ),
			                "P(peronismo) 2027", SWITCH ( TRUE (), ISBLANK ( p ), "#3A3350", p >= 0.9, "#29A3F0", p >= 0.6, "#2178B8", p >= 0.4, "#C40BFF", p >= 0.1, "#5B3FA8", "#7E57FF" ),
			                "% Peronismo", SWITCH ( TRUE (), ISBLANK ( v ), "#3A3350", v >= 0.55, "#0B6FB8", v >= 0.45, "#29A3F0", v >= 0.35, "#7CC4F2", v >= 0.25, "#3A4E78", "#2A2350" ),
			                "#3A3350"
			            )
			        RETURN "<path fill='" & IF ( c IN vis, relleno, "#241448" ) & "' d='" & dim_municipio[svg_conu] & "'/>",
			        ""
			    )
			VAR resalte =
			    IF (
			        n = 1 && n < total,
			        "<path fill='none' stroke='#FFFFFF' stroke-width='3' stroke-linejoin='round' d='" & CALCULATE ( MAX ( dim_municipio[svg_conu] ) ) & "'/>"
			    )
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 759'><g stroke='#12042E' stroke-width='0.7' stroke-linejoin='round'>" & cuerpo & "</g>" & resalte & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( svg, "#", "%23" )
		dataCategory: ImageUrl
		displayFolder: Mapa
		lineageTag: 51522113-4317-5af0-85b6-e067d1f6a7a1

	measure 'Leyenda mapa' =
			VAR c = SELECTEDVALUE ( capa_mapa[capa], "Espacio 2026" )
			RETURN LOOKUPVALUE ( capa_mapa[leyenda_svg], capa_mapa[capa], c )
		dataCategory: ImageUrl
		displayFolder: Mapa
		lineageTag: 196b4e72-0568-5c9b-af32-f0eacfd4234a

	measure 'Título mapa' =
			VAR c = SELECTEDVALUE ( capa_mapa[capa], "Espacio 2026" )
			VAR d = LOOKUPVALUE ( capa_mapa[descripcion], capa_mapa[capa], c )
			RETURN d & IF ( c IN { "Ganador de la elección", "% Peronismo" }, " · " & [Elección seleccionada], "" ) & IF ( c = "P(peronismo) 2027", " · " & SELECTEDVALUE ( fact_motor_2027[escenario], "Se repite octubre 2025" ), "" )
		displayFolder: Mapa
		lineageTag: 31987636-c4f0-50b3-ad03-eda0a509d58f

	measure 'Color espacio 2026' = SELECTEDVALUE ( dim_municipio[color_espacio_2026] )
		displayFolder: Formato
		lineageTag: dc647420-2ccf-58cb-9b7e-bea0d0f307f3

	measure 'Color escenario' = SELECTEDVALUE ( dim_municipio[color_escenario] )
		displayFolder: Formato
		lineageTag: 3ee298b2-c264-56fc-8149-69fc1d337644

	measure 'Color oportunidad' = SELECTEDVALUE ( dim_municipio[color_oportunidad] )
		displayFolder: Formato
		lineageTag: c578fb8a-a3a3-596c-b5c2-bba41195867a

	measure 'Color prioridad' = SWITCH ( SELECTEDVALUE ( prospectos[prioridad] ), "Alta", "#C40BFF", "Media", "#5B3FA8", "Baja", "#3A2A66" )
		displayFolder: Formato
		lineageTag: 072677c6-0972-5885-98c3-f6d5207325a5

	measure 'Título ficha' = IF ( HASONEVALUE ( dim_municipio[cod_indec] ), SELECTEDVALUE ( dim_municipio[municipio] ) & " · " & SELECTEDVALUE ( dim_municipio[seccion] ) & " sección · " & SELECTEDVALUE ( dim_municipio[escenario_2027] ), "Elegí un municipio (o hacé clic derecho > Obtener detalles en cualquier página)" )
		displayFolder: Ficha
		lineageTag: f9950877-4497-5a81-9dec-863fda594295

	measure 'Título dashboard' = "Intendencias PBA 2027 · " & FORMAT ( [Municipios], "#,0" ) & " municipios · " & FORMAT ( [Población], "#,0" ) & " habitantes"
		displayFolder: Ficha
		lineageTag: 033774cb-2d97-53c7-b1e9-6cf246abfd5a

	measure 'P(peronismo) 2027 en ficha' = CALCULATE ( [P(peronismo) 2027], fact_motor_2027[escenario_clave] = "A" )
		formatString: 0%
		displayFolder: 2027
		lineageTag: d91d08af-bacd-5464-8717-500d162503df

	column x
		dataType: string
		isHidden
		lineageTag: c7e6b47c-f74a-5c26-b4d4-d53124329621
		summarizeBy: none
		sourceColumn: x

	partition Medidas = m
		mode: import
		source = #table(type table [x = text], {})

	annotation PBI_ResultType = Table
