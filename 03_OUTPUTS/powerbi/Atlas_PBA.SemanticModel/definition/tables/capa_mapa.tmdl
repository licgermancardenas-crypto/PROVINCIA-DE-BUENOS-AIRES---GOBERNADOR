	partition capa_mapa = m
		mode: import
		source =
				let
				    Origen_capa_mapa = Csv.Document(File.Contents(CarpetaDatos & "capa_mapa.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Enc_capa_mapa = Table.PromoteHeaders(Origen_capa_mapa, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Enc_capa_mapa, {{"capa", type text}, {"orden", Int64.Type}, {"descripcion", type text}, {"leyenda_svg", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
