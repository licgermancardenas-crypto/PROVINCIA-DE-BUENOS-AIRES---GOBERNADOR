	partition prospectos = m
		mode: import
		source =
				let
				    Origen_prospectos = Csv.Document(File.Contents(CarpetaPrivada & "prospectos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Enc_prospectos = Table.PromoteHeaders(Origen_prospectos, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Enc_prospectos, {{"cod_indec", type text}, {"municipio", type text}, {"nombre", type text}, {"espacio", type text}, {"fuerza_familia", type text}, {"rol", type text}, {"por_que", type text}, {"detalle", type text}, {"prioridad", type text}, {"fuente", type text}, {"estado", type text}, {"notas", type number}, {"proximo_paso", type number}, {"fecha_proximo_paso", type number}, {"orden_prioridad", Int64.Type}, {"clave", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
