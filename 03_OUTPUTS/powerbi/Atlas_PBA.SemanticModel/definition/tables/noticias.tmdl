	partition noticias = m
		mode: import
		source =
				let
				    Origen_noticias = Csv.Document(File.Contents(CarpetaPrivada & "noticias.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Enc_noticias = Table.PromoteHeaders(Origen_noticias, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Enc_noticias, {{"cod_indec", type text}, {"municipio", type text}, {"fecha", type text}, {"titular", type text}, {"medio", type text}, {"url", type text}, {"mes", type text}, {"clave", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
