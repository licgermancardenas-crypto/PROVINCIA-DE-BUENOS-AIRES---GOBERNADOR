table Medidas

	measure 'Elección activa' =
			SELECTEDVALUE ( dim_eleccion[eleccion], "D2025" )
		displayFolder: 01 · Votos

	measure 'Elección seleccionada' =
			SELECTEDVALUE ( dim_eleccion[rotulo], "Diputados nacionales 2025" )
		displayFolder: 01 · Votos

	measure Votos =
			IF ( HASONEVALUE ( dim_eleccion[eleccion] ), SUM ( fact_votos[votos] ), CALCULATE ( SUM ( fact_votos[votos] ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: 01 · Votos

	measure '% Voto' =
			DIVIDE ( [Votos], CALCULATE ( [Votos], REMOVEFILTERS ( dim_espacio ) ) )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure '% Peronismo' =
			CALCULATE ( [% Voto], dim_espacio[espacio] = "PERONISMO" )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure '% Derecha' =
			CALCULATE ( [% Voto], dim_espacio[espacio] IN { "LLA", "LLA_PRO", "PRO_JXC" } )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure Ganador =
			VAR t = ADDCOLUMNS ( VALUES ( dim_espacio[espacio_nombre] ), "@v", [Votos] )
			RETURN MAXX ( TOPN ( 1, t, [@v], DESC ), dim_espacio[espacio_nombre] )
		displayFolder: 01 · Votos

	measure '% Ganador' =
			MAXX ( VALUES ( dim_espacio[espacio] ), [% Voto] )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure 'Margen (pts)' =
			VAR t = ADDCOLUMNS ( VALUES ( dim_espacio[espacio] ), "@p", [% Voto] )
			VAR p1 = MAXX ( t, [@p] )
			VAR p2 = MAXX ( FILTER ( t, [@p] < p1 ), [@p] )
			RETURN ( p1 - p2 ) * 100
		formatString: 0.0
		displayFolder: 01 · Votos

	measure Electores =
			IF ( HASONEVALUE ( dim_eleccion[eleccion] ), SUM ( fact_participacion[electores] ), CALCULATE ( SUM ( fact_participacion[electores] ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: 01 · Votos

	measure Votantes =
			VAR v = SUMX ( fact_participacion, fact_participacion[electores] * fact_participacion[participacion] / 100 )
			RETURN IF ( HASONEVALUE ( dim_eleccion[eleccion] ), v, CALCULATE ( SUMX ( fact_participacion, fact_participacion[electores] * fact_participacion[participacion] / 100 ), dim_eleccion[eleccion] = "D2025" ) )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Participación' =
			DIVIDE ( [Votantes], [Electores] )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure Municipios =
			DISTINCTCOUNT ( dim_municipio[cod_indec] )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Población' =
			SUM ( dim_municipio[pob] )
		formatString: #,0
		displayFolder: 01 · Votos

	measure '% de la Provincia' =
			DIVIDE ( [Población], CALCULATE ( [Población], REMOVEFILTERS ( dim_municipio ) ) )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure 'Hogares con NBI %' =
			DIVIDE ( SUMX ( dim_municipio, dim_municipio[hogares] * dim_municipio[nbi] / 100 ), SUM ( dim_municipio[hogares] ) )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure 'Hogares en barrios populares %' =
			DIVIDE ( SUMX ( dim_municipio, dim_municipio[hogares] * dim_municipio[pct_barrio_popular] / 100 ), SUM ( dim_municipio[hogares] ) )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure 'Universitarios %' =
			DIVIDE ( SUMX ( dim_municipio, dim_municipio[pob] * dim_municipio[pct_univ] / 100 ), [Población] )
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure Escuelas =
			SUM ( dim_municipio[escuelas] )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Transferencias por habitante' =
			DIVIDE ( SUMX ( dim_municipio, dim_municipio[transferencias_hab] * dim_municipio[pob] ), [Población] )
		formatString: $ #,0
		displayFolder: 01 · Votos

	measure Intendente =
			SELECTEDVALUE ( dim_municipio[intendente], "Elegí un municipio" )
		displayFolder: 04 · Textos y colores

	measure Municipio =
			SELECTEDVALUE ( dim_municipio[municipio], "Provincia de Buenos Aires" )
		displayFolder: 04 · Textos y colores

	measure 'Foto intendente' =
			SELECTEDVALUE ( dim_municipio[foto_url] )
		displayFolder: 04 · Textos y colores
		dataCategory: ImageUrl

	measure 'Título elección' =
			"Resultado · " & [Elección seleccionada]
		displayFolder: 01 · Votos

	measure 'P(peronismo) 2027' =
			AVERAGE ( fact_motor_2027[p_gana_peronismo] )
		formatString: 0%
		displayFolder: 01 · Votos

	measure 'Municipios peronistas esperados' =
			SUM ( fact_motor_2027[p_gana_peronismo] )
		formatString: #,0.0
		displayFolder: 01 · Votos

	measure 'Municipios en disputa' =
			COUNTROWS ( FILTER ( fact_motor_2027, fact_motor_2027[p_gana_peronismo] >= 0.2 && fact_motor_2027[p_gana_peronismo] <= 0.8 ) )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Municipios ganados' =
			DISTINCTCOUNT ( fact_participacion[cod_indec] )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Título mapa ganador' =
			"Quién ganó cada municipio · " & [Elección seleccionada]
		displayFolder: 01 · Votos

	measure 'Título mapa peronismo' =
			"% del peronismo por municipio · " & [Elección seleccionada]
		displayFolder: 01 · Votos

	measure 'Título mapa participación' =
			"Participación por municipio · " & [Elección seleccionada]
		displayFolder: 01 · Votos

	measure 'Título ficha voto' =
			[Municipio] & IF ( HASONEVALUE ( dim_municipio[cod_indec] ), " · " & SELECTEDVALUE ( dim_municipio[seccion] ) & " sección electoral · intendente: " & SELECTEDVALUE ( dim_municipio[intendente] ), " · elegí un municipio" )
		displayFolder: 01 · Votos

	measure 'Título mapa 2027' =
			"Motor 2027: probabilidad de que gane el peronismo · " & SELECTEDVALUE ( fact_motor_2027[escenario], "elegí un escenario" )
		displayFolder: 01 · Votos

	measure 'Votos peronismo' =
			CALCULATE ( [Votos], dim_espacio[espacio] = "PERONISMO" )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Votos derecha' =
			CALCULATE ( [Votos], dim_espacio[espacio] IN { "LLA", "LLA_PRO", "PRO_JXC" } )
		formatString: #,0
		displayFolder: 01 · Votos

	measure 'Diferencia de votos' =
			[Votos peronismo] - [Votos derecha]
		formatString: +#,0;-#,0;0
		displayFolder: 01 · Votos

	measure 'NBI municipio' =
			AVERAGE ( dim_municipio[nbi] )
		formatString: 0.0
		displayFolder: 01 · Votos

	measure 'Color espacio' =
			SELECTEDVALUE(dim_espacio[color], "#9A93AD")
		displayFolder: 04 · Textos y colores

	measure 'Color ganador' =
			LOOKUPVALUE(dim_espacio[color], dim_espacio[espacio_nombre], [Ganador], "#9A93AD")
		displayFolder: 04 · Textos y colores

	measure 'Margen P-D (pts)' =
			([% Peronismo] - [% Derecha]) * 100
		formatString: +0.0;-0.0;0
		displayFolder: 01 · Votos

	measure 'Cambio peronismo vs 2023 (pts)' =
			([% Peronismo] - CALCULATE([% Peronismo], REMOVEFILTERS(dim_eleccion), dim_eleccion[eleccion] = "G2023")) * 100
		formatString: +0.0;-0.0;0
		displayFolder: 01 · Votos

	measure 'P(peronismo) 2027 base' =
			IF(ISFILTERED(fact_motor_2027[escenario]), AVERAGE(fact_motor_2027[p_gana_peronismo]), CALCULATE(AVERAGE(fact_motor_2027[p_gana_peronismo]), fact_motor_2027[escenario_clave] = "A"))
		formatString: 0%
		displayFolder: 03 · Pronóstico 2027

	measure 'Electores provincia' =
			CALCULATE([Electores], REMOVEFILTERS(dim_municipio))
		formatString: #,0
		displayFolder: 01 · Votos

	measure '% del padrón provincial' =
			DIVIDE([Electores], [Electores provincia])
		formatString: 0.0%
		displayFolder: 01 · Votos

	measure 'Color diferencia' =
			IF([Diferencia de votos] >= 0, "#2F80ED", "#6A1B9A")
		displayFolder: 04 · Textos y colores

	measure 'Margen escenario' =
			SUM(escenarios_2027[margen])
		formatString: +0.0;-0.0;0
		displayFolder: 03 · Pronóstico 2027

	measure 'Color escenario' =
			IF([Margen escenario] >= 0, "#2F80ED", "#6A1B9A")
		displayFolder: 04 · Textos y colores

	measure 'Pronóstico P(gana)' =
			LOOKUPVALUE(escenarios_2027[p_gana_peronismo], escenarios_2027[escenario], "Se repite octubre 2025")
		formatString: 0%
		displayFolder: 03 · Pronóstico 2027

	measure 'Pronóstico margen' =
			LOOKUPVALUE(escenarios_2027[margen], escenarios_2027[escenario], "Se repite octubre 2025")
		formatString: +0.0;-0.0;0
		displayFolder: 03 · Pronóstico 2027

	measure 'Pronóstico rango' =
			FORMAT(LOOKUPVALUE(escenarios_2027[margen_p10], escenarios_2027[escenario], "Se repite octubre 2025"), "+0.0;-0.0") & " a " & FORMAT(LOOKUPVALUE(escenarios_2027[margen_p90], escenarios_2027[escenario], "Se repite octubre 2025"), "+0.0;-0.0") & " pts"
		displayFolder: 03 · Pronóstico 2027

	measure 'Pronóstico municipios' =
			LOOKUPVALUE(escenarios_2027[municipios_peronistas], escenarios_2027[escenario], "Se repite octubre 2025")
		formatString: 0
		displayFolder: 03 · Pronóstico 2027

	measure 'Métrica' =
			SELECTEDVALUE(metrica_mapa[id], 1)
		formatString: 0
		displayFolder: 02 · Mapa

	measure 'Valor métrica' =
			VAR idm = [Métrica] RETURN SWITCH(idm, 1, [% Ganador], 2, [% Peronismo], 3, [% Derecha], 4, [Margen P-D (pts)], 5, [Participación], 6, [Cambio peronismo vs 2023 (pts)], 7, [P(peronismo) 2027 base], 8, [Hogares con NBI %], 9, [Hogares en barrios populares %], 10, [Electores], 11, [Uno], 12, [Corrimiento peronismo (pts)], 13, [Uno], BLANK())
		displayFolder: 02 · Mapa
		formatStringDefinition = VAR idm = [Métrica] RETURN SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())

	measure 'Valor métrica (texto)' =
			VAR idm = [Métrica] VAR v = [Valor métrica] RETURN IF(ISBLANK(v), "—", FORMAT(v, SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())) & IF(idm = 1, " · " & [Ganador], ""))
		displayFolder: 02 · Mapa

	measure 'Color métrica' =
			VAR idm = [Métrica]
			VAR modo = SWITCH(idm, 1, 2, 2, 1, 3, 1, 4, 3, 5, 1, 6, 3, 7, 1, 8, 1, 9, 1, 10, 1, 11, 2, 12, 3, 13, 2, BLANK())
			VAR base = SWITCH(idm, 2, "#2F80ED", 3, "#6A1B9A", 4, "#2F80ED", 5, "#5B3F99", 6, "#2F80ED", 7, "#2F80ED", 8, "#C62828", 9, "#E0A526", 10, "#1D1631", 12, "#2F80ED", BLANK())
			VAR neg = SWITCH(idm, 4, "#6A1B9A", 6, "#C62828", 12, "#C62828", BLANK())
			VAR fmtv = SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())
			VAR v = [Valor métrica]
			RETURN SWITCH(TRUE(), modo = 2, [Color ganador], modo = 3 && v < 0, neg, base)
		displayFolder: 04 · Textos y colores

	measure 'Título del mapa' =
			VAR m = SELECTEDVALUE(metrica_mapa[metrica], "Ganador de la elección")
			VAR idm = [Métrica]
			RETURN m & SWITCH(TRUE(), idm <= 6 || idm = 10, "  ·  " & [Elección seleccionada], idm = 7, "  ·  " & SELECTEDVALUE(fact_motor_2027[escenario], "escenario: se repite octubre 2025"), idm = 12, "  ·  " & [Elección seleccionada] & " vs. " & [Elección base elegida], idm = 11 || idm = 13, "  ·  intendentes en ejercicio", "  ·  censo 2022")
		displayFolder: 02 · Mapa

	measure Corte =
			"Elección: " & [Elección seleccionada] & "  ·  datos DINE, Junta Electoral PBA, INDEC 2022  ·  motor ATLAS (1.000 simulaciones)"
		displayFolder: 04 · Textos y colores

	measure 'Título ficha' =
			IF(HASONEVALUE(dim_municipio[cod_indec]), SELECTEDVALUE(dim_municipio[municipio]), "Elegí un municipio")
		displayFolder: 04 · Textos y colores

	measure 'Subtítulo ficha' =
			IF(HASONEVALUE(dim_municipio[cod_indec]), SELECTEDVALUE(dim_municipio[seccion]) & " sección electoral  ·  " & SELECTEDVALUE(dim_municipio[zona]) & "  ·  intendente: " & SELECTEDVALUE(dim_municipio[intendente]) & " (" & SELECTEDVALUE(dim_municipio[fuerza_intendente]) & ")", "Clic derecho sobre un municipio en cualquier página › Obtener detalles › Ficha del municipio")
		displayFolder: 04 · Textos y colores

	measure 'SVG mapa provincia' =
			VAR idm = [Métrica]
			VAR modo = SWITCH(idm, 1, 2, 2, 1, 3, 1, 4, 3, 5, 1, 6, 3, 7, 1, 8, 1, 9, 1, 10, 1, 11, 2, 12, 3, 13, 2, BLANK())
			VAR base = SWITCH(idm, 2, "#2F80ED", 3, "#6A1B9A", 4, "#2F80ED", 5, "#5B3F99", 6, "#2F80ED", 7, "#2F80ED", 8, "#C62828", 9, "#E0A526", 10, "#1D1631", 12, "#2F80ED", BLANK())
			VAR neg = SWITCH(idm, 4, "#6A1B9A", 6, "#C62828", 12, "#C62828", BLANK())
			VAR fmtv = SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())
			VAR x_ley = 392
			VAR y_ley = 640
			VAR mostrar_ley = TRUE()
			VAR cuerpo =
			VAR sel = VALUES(dim_municipio[cod_indec])
			VAR filas = ADDCOLUMNS(FILTER(ALL(dim_municipio[cod_indec], dim_municipio[svg_prov], dim_municipio[cx_p], dim_municipio[cy_p], dim_municipio[nombre_corto], dim_municipio[rotulo_p]), dim_municipio[svg_prov] <> ""),
			    "v", IF(dim_municipio[cod_indec] IN sel, [Valor métrica]),
			    "cc", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Color ganador], 11, [Color intendente], 13, [Color reelección], BLANK())),
			    "nn", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Ganador], 11, [Fuerza del intendente], 13, [Reelección 2027], BLANK())))
			VAR lo = MINX(filas, [v])
			VAR hi = MAXX(filas, [v])
			VAR ma = MAXX(filas, ABS([v]))
			VAR formas = CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 2, [cc], modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 2, 99, INT(14 + 85 * t))
			    RETURN "<path d='" & dim_municipio[svg_prov] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "")
			VAR rotulos = CONCATENATEX(FILTER(filas, NOT ISBLANK([v])), SWITCH(dim_municipio[rotulo_p], 2, "<text x='" & dim_municipio[cx_p] & "' y='" & dim_municipio[cy_p] & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='600' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & dim_municipio[nombre_corto] & "</text><text x='" & dim_municipio[cx_p] & "' y='" & (dim_municipio[cy_p] + 10) & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", 1, "<text x='" & dim_municipio[cx_p] & "' y='" & (dim_municipio[cy_p] + 3) & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", ""), "")
			VAR cats = DISTINCT(SELECTCOLUMNS(FILTER(filas, NOT ISBLANK([cc])), "c", [cc], "n", [nn]))
			VAR catsI = ADDCOLUMNS(cats, "i", VAR yo = [n] RETURN COUNTROWS(FILTER(cats, [n] < yo)))
			VAR ley = IF(modo = 2,
			    CONCATENATEX(catsI, "<rect x='" & x_ley & "' y='" & (4 + [i] * 24) & "' width='20' height='16' rx='3' fill='" & [c] & "'/><text x='" & (x_ley + 28) & "' y='" & (17 + [i] * 24) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & [n] & "</text>", ""),
			    "<rect x='" & x_ley & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.14") & "'/>"
			    & "<rect x='" & (x_ley + 34) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.45", "0.35") & "'/>"
			    & "<rect x='" & (x_ley + 68) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, "#E4DFEE", base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.56") & "'/>"
			    & "<rect x='" & (x_ley + 102) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='" & IF(modo = 3, "0.45", "0.77") & "'/>"
			    & "<rect x='" & (x_ley + 136) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='0.99'/>"
			    & "<text x='" & x_ley & "' y='38' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, -ma, lo), fmtv) & "</text>"
			    & "<text x='" & (x_ley + 170) & "' y='38' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, ma, hi), fmtv) & "</text>")
			VAR uno = COUNTROWS(sel) = 1 && COUNTROWS(ALL(dim_municipio[cod_indec])) > 1
			VAR resalte = IF(uno, "<path d='" & MAXX(FILTER(filas, dim_municipio[cod_indec] IN sel), dim_municipio[svg_prov])
			    & "' fill='none' stroke='#1D1631' stroke-width='2' stroke-linejoin='round'><animate attributeName='stroke-width' values='1.5;5;1.5' dur='1.6s' repeatCount='indefinite'/></path>", "")
			RETURN "<g stroke='#FFFFFF' stroke-width='0.6' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & formas & "</g>"
			    & "<g><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & rotulos & "</g>" & resalte
			    & IF(mostrar_ley, "<g transform='translate(0 " & y_ley & ")'><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & ley & "</g>", "")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 894'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 02 · Mapa
		dataCategory: ImageUrl

	measure 'SVG mapa conurbano' =
			VAR idm = [Métrica]
			VAR modo = SWITCH(idm, 1, 2, 2, 1, 3, 1, 4, 3, 5, 1, 6, 3, 7, 1, 8, 1, 9, 1, 10, 1, 11, 2, 12, 3, 13, 2, BLANK())
			VAR base = SWITCH(idm, 2, "#2F80ED", 3, "#6A1B9A", 4, "#2F80ED", 5, "#5B3F99", 6, "#2F80ED", 7, "#2F80ED", 8, "#C62828", 9, "#E0A526", 10, "#1D1631", 12, "#2F80ED", BLANK())
			VAR neg = SWITCH(idm, 4, "#6A1B9A", 6, "#C62828", 12, "#C62828", BLANK())
			VAR fmtv = SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())
			VAR x_ley = 0
			VAR y_ley = 0
			VAR mostrar_ley = FALSE()
			VAR cuerpo =
			VAR sel = VALUES(dim_municipio[cod_indec])
			VAR filas = ADDCOLUMNS(FILTER(ALL(dim_municipio[cod_indec], dim_municipio[svg_conu], dim_municipio[cx_c], dim_municipio[cy_c], dim_municipio[nombre_corto], dim_municipio[rotulo_c]), dim_municipio[svg_conu] <> ""),
			    "v", IF(dim_municipio[cod_indec] IN sel, [Valor métrica]),
			    "cc", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Color ganador], 11, [Color intendente], 13, [Color reelección], BLANK())),
			    "nn", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Ganador], 11, [Fuerza del intendente], 13, [Reelección 2027], BLANK())))
			VAR lo = MINX(filas, [v])
			VAR hi = MAXX(filas, [v])
			VAR ma = MAXX(filas, ABS([v]))
			VAR formas = CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 2, [cc], modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 2, 99, INT(14 + 85 * t))
			    RETURN "<path d='" & dim_municipio[svg_conu] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "")
			VAR rotulos = CONCATENATEX(FILTER(filas, NOT ISBLANK([v])), SWITCH(dim_municipio[rotulo_c], 2, "<text x='" & dim_municipio[cx_c] & "' y='" & dim_municipio[cy_c] & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='600' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & dim_municipio[nombre_corto] & "</text><text x='" & dim_municipio[cx_c] & "' y='" & (dim_municipio[cy_c] + 11) & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", 1, "<text x='" & dim_municipio[cx_c] & "' y='" & (dim_municipio[cy_c] + 3) & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", ""), "")
			VAR cats = DISTINCT(SELECTCOLUMNS(FILTER(filas, NOT ISBLANK([cc])), "c", [cc], "n", [nn]))
			VAR catsI = ADDCOLUMNS(cats, "i", VAR yo = [n] RETURN COUNTROWS(FILTER(cats, [n] < yo)))
			VAR ley = IF(modo = 2,
			    CONCATENATEX(catsI, "<rect x='" & x_ley & "' y='" & (4 + [i] * 24) & "' width='20' height='16' rx='3' fill='" & [c] & "'/><text x='" & (x_ley + 28) & "' y='" & (17 + [i] * 24) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & [n] & "</text>", ""),
			    "<rect x='" & x_ley & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.14") & "'/>"
			    & "<rect x='" & (x_ley + 34) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.45", "0.35") & "'/>"
			    & "<rect x='" & (x_ley + 68) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, "#E4DFEE", base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.56") & "'/>"
			    & "<rect x='" & (x_ley + 102) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='" & IF(modo = 3, "0.45", "0.77") & "'/>"
			    & "<rect x='" & (x_ley + 136) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='0.99'/>"
			    & "<text x='" & x_ley & "' y='38' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, -ma, lo), fmtv) & "</text>"
			    & "<text x='" & (x_ley + 170) & "' y='38' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, ma, hi), fmtv) & "</text>")
			VAR uno = COUNTROWS(sel) = 1 && COUNTROWS(ALL(dim_municipio[cod_indec])) > 1
			VAR resalte = IF(uno, "<path d='" & MAXX(FILTER(filas, dim_municipio[cod_indec] IN sel), dim_municipio[svg_conu])
			    & "' fill='none' stroke='#1D1631' stroke-width='2' stroke-linejoin='round'><animate attributeName='stroke-width' values='1.5;5;1.5' dur='1.6s' repeatCount='indefinite'/></path>", "")
			RETURN "<g stroke='#FFFFFF' stroke-width='0.9' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & formas & "</g>"
			    & "<g><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & rotulos & "</g>" & resalte
			    & IF(mostrar_ley, "<g transform='translate(0 " & y_ley & ")'><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & ley & "</g>", "")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 759'>" & cuerpo & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 02 · Mapa
		dataCategory: ImageUrl

	measure 'SVG mapa completo' =
			VAR idm = [Métrica]
			VAR modo = SWITCH(idm, 1, 2, 2, 1, 3, 1, 4, 3, 5, 1, 6, 3, 7, 1, 8, 1, 9, 1, 10, 1, 11, 2, 12, 3, 13, 2, BLANK())
			VAR base = SWITCH(idm, 2, "#2F80ED", 3, "#6A1B9A", 4, "#2F80ED", 5, "#5B3F99", 6, "#2F80ED", 7, "#2F80ED", 8, "#C62828", 9, "#E0A526", 10, "#1D1631", 12, "#2F80ED", BLANK())
			VAR neg = SWITCH(idm, 4, "#6A1B9A", 6, "#C62828", 12, "#C62828", BLANK())
			VAR fmtv = SWITCH(idm, 1, "0%", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "0%", 6, "+0;-0;0", 7, "0%", 8, "0.0%", 9, "0.0%", 10, "#,0", 11, ";;;", 12, "+0;-0;0", 13, ";;;", BLANK())
			VAR selg = VALUES(dim_municipio[cod_indec])
			VAR todos = ADDCOLUMNS(ALL(dim_municipio[cod_indec]), "v", IF(dim_municipio[cod_indec] IN selg, [Valor métrica]))
			VAR lo_g = MINX(todos, [v])
			VAR hi_g = MAXX(todos, [v])
			VAR ma_g = MAXX(todos, ABS([v]))
			VAR x_ley = 392
			VAR y_ley = 640
			VAR mostrar_ley = TRUE()
			VAR prov =
			VAR sel = VALUES(dim_municipio[cod_indec])
			VAR filas = ADDCOLUMNS(FILTER(ALL(dim_municipio[cod_indec], dim_municipio[svg_prov], dim_municipio[cx_p], dim_municipio[cy_p], dim_municipio[nombre_corto], dim_municipio[rotulo_p]), dim_municipio[svg_prov] <> ""),
			    "v", IF(dim_municipio[cod_indec] IN sel, [Valor métrica]),
			    "cc", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Color ganador], 11, [Color intendente], 13, [Color reelección], BLANK())),
			    "nn", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Ganador], 11, [Fuerza del intendente], 13, [Reelección 2027], BLANK())))
			VAR lo = lo_g
			VAR hi = hi_g
			VAR ma = ma_g
			VAR formas = CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 2, [cc], modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 2, 99, INT(14 + 85 * t))
			    RETURN "<path d='" & dim_municipio[svg_prov] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "")
			VAR rotulos = CONCATENATEX(FILTER(filas, NOT ISBLANK([v])), SWITCH(dim_municipio[rotulo_p], 2, "<text x='" & dim_municipio[cx_p] & "' y='" & dim_municipio[cy_p] & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='600' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & dim_municipio[nombre_corto] & "</text><text x='" & dim_municipio[cx_p] & "' y='" & (dim_municipio[cy_p] + 10) & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", 1, "<text x='" & dim_municipio[cx_p] & "' y='" & (dim_municipio[cy_p] + 3) & "' text-anchor='middle' font-family='Segoe UI' font-size='8.5' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", ""), "")
			VAR cats = DISTINCT(SELECTCOLUMNS(FILTER(filas, NOT ISBLANK([cc])), "c", [cc], "n", [nn]))
			VAR catsI = ADDCOLUMNS(cats, "i", VAR yo = [n] RETURN COUNTROWS(FILTER(cats, [n] < yo)))
			VAR ley = IF(modo = 2,
			    CONCATENATEX(catsI, "<rect x='" & x_ley & "' y='" & (4 + [i] * 24) & "' width='20' height='16' rx='3' fill='" & [c] & "'/><text x='" & (x_ley + 28) & "' y='" & (17 + [i] * 24) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & [n] & "</text>", ""),
			    "<rect x='" & x_ley & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.14") & "'/>"
			    & "<rect x='" & (x_ley + 34) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.45", "0.35") & "'/>"
			    & "<rect x='" & (x_ley + 68) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, "#E4DFEE", base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.56") & "'/>"
			    & "<rect x='" & (x_ley + 102) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='" & IF(modo = 3, "0.45", "0.77") & "'/>"
			    & "<rect x='" & (x_ley + 136) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='0.99'/>"
			    & "<text x='" & x_ley & "' y='38' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, -ma, lo), fmtv) & "</text>"
			    & "<text x='" & (x_ley + 170) & "' y='38' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, ma, hi), fmtv) & "</text>")
			VAR uno = COUNTROWS(sel) = 1 && COUNTROWS(ALL(dim_municipio[cod_indec])) > 1
			VAR resalte = IF(uno, "<path d='" & MAXX(FILTER(filas, dim_municipio[cod_indec] IN sel), dim_municipio[svg_prov])
			    & "' fill='none' stroke='#1D1631' stroke-width='2' stroke-linejoin='round'><animate attributeName='stroke-width' values='1.5;5;1.5' dur='1.6s' repeatCount='indefinite'/></path>", "")
			RETURN "<g stroke='#FFFFFF' stroke-width='0.6' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & formas & "</g>"
			    & "<g><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & rotulos & "</g>" & resalte
			    & IF(mostrar_ley, "<g transform='translate(0 " & y_ley & ")'><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & ley & "</g>", "")
			VAR conu =
			VAR sel = VALUES(dim_municipio[cod_indec])
			VAR filas = ADDCOLUMNS(FILTER(ALL(dim_municipio[cod_indec], dim_municipio[svg_conu], dim_municipio[cx_c], dim_municipio[cy_c], dim_municipio[nombre_corto], dim_municipio[rotulo_c]), dim_municipio[svg_conu] <> ""),
			    "v", IF(dim_municipio[cod_indec] IN sel, [Valor métrica]),
			    "cc", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Color ganador], 11, [Color intendente], 13, [Color reelección], BLANK())),
			    "nn", IF(modo = 2 && dim_municipio[cod_indec] IN sel, SWITCH(idm, 1, [Ganador], 11, [Fuerza del intendente], 13, [Reelección 2027], BLANK())))
			VAR lo = lo_g
			VAR hi = hi_g
			VAR ma = ma_g
			VAR formas = CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 2, [cc], modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 2, 99, INT(14 + 85 * t))
			    RETURN "<path d='" & dim_municipio[svg_conu] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "")
			VAR rotulos = CONCATENATEX(FILTER(filas, NOT ISBLANK([v])), SWITCH(dim_municipio[rotulo_c], 2, "<text x='" & dim_municipio[cx_c] & "' y='" & dim_municipio[cy_c] & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='600' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & dim_municipio[nombre_corto] & "</text><text x='" & dim_municipio[cx_c] & "' y='" & (dim_municipio[cy_c] + 11) & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", 1, "<text x='" & dim_municipio[cx_c] & "' y='" & (dim_municipio[cy_c] + 3) & "' text-anchor='middle' font-family='Segoe UI' font-size='10' font-weight='700' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & FORMAT([v], fmtv) & "</text>", ""), "")
			VAR cats = DISTINCT(SELECTCOLUMNS(FILTER(filas, NOT ISBLANK([cc])), "c", [cc], "n", [nn]))
			VAR catsI = ADDCOLUMNS(cats, "i", VAR yo = [n] RETURN COUNTROWS(FILTER(cats, [n] < yo)))
			VAR ley = IF(modo = 2,
			    CONCATENATEX(catsI, "<rect x='" & x_ley & "' y='" & (4 + [i] * 24) & "' width='20' height='16' rx='3' fill='" & [c] & "'/><text x='" & (x_ley + 28) & "' y='" & (17 + [i] * 24) & "' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & [n] & "</text>", ""),
			    "<rect x='" & x_ley & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.14") & "'/>"
			    & "<rect x='" & (x_ley + 34) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='" & IF(modo = 3, "0.45", "0.35") & "'/>"
			    & "<rect x='" & (x_ley + 68) & "' y='4' width='34' height='16' fill='" & IF(modo = 3, "#E4DFEE", base) & "' fill-opacity='" & IF(modo = 3, "0.99", "0.56") & "'/>"
			    & "<rect x='" & (x_ley + 102) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='" & IF(modo = 3, "0.45", "0.77") & "'/>"
			    & "<rect x='" & (x_ley + 136) & "' y='4' width='34' height='16' fill='" & base & "' fill-opacity='0.99'/>"
			    & "<text x='" & x_ley & "' y='38' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, -ma, lo), fmtv) & "</text>"
			    & "<text x='" & (x_ley + 170) & "' y='38' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, ma, hi), fmtv) & "</text>")
			VAR uno = COUNTROWS(sel) = 1 && COUNTROWS(ALL(dim_municipio[cod_indec])) > 1
			VAR resalte = IF(uno, "<path d='" & MAXX(FILTER(filas, dim_municipio[cod_indec] IN sel), dim_municipio[svg_conu])
			    & "' fill='none' stroke='#1D1631' stroke-width='2' stroke-linejoin='round'><animate attributeName='stroke-width' values='1.5;5;1.5' dur='1.6s' repeatCount='indefinite'/></path>", "")
			RETURN "<g stroke='#FFFFFF' stroke-width='0.9' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & formas & "</g>"
			    & "<g><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & rotulos & "</g>" & resalte
			    & IF(FALSE(), "<g transform='translate(0 " & y_ley & ")'><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & ley & "</g>", "")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1240 894'>" & prov
			    & "<g transform='translate(640 44)'><rect x='0' y='0' width='600' height='759' rx='10' fill='#FFFFFF' stroke='#E4DFEE' stroke-width='2'/>" & conu & "</g>"
			    & "<text x='640' y='30' font-family='Segoe UI' font-size='18' font-weight='700' fill='#5B3F99'>Conurbano y Gran La Plata</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 02 · Mapa
		dataCategory: ImageUrl

	measure 'SVG barra pronóstico' =
			VAR p = (50 + LOOKUPVALUE(escenarios_2027[margen], escenarios_2027[escenario], "Se repite octubre 2025") / 2)
			VAR d = (50 - LOOKUPVALUE(escenarios_2027[margen], escenarios_2027[escenario], "Se repite octubre 2025") / 2)
			VAR w = INT(1000 * DIVIDE(p, p + d))
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 120'>"
			    & "<text x='500' y='18' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#1D1631'>50 %</text>"
			    & "<rect x='0' y='30' width='" & w & "' height='70' fill='#2F80ED'><animate attributeName='width' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<rect x='" & w & "' y='30' width='" & (1000 - w) & "' height='70' fill='#6A1B9A'><animate attributeName='x' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/><animate attributeName='width' from='500' to='" & (1000 - w) & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<line x1='500' y1='24' x2='500' y2='108' stroke='#1D1631' stroke-width='3' stroke-dasharray='7 5'/>"
			    & "<text x='18' y='76' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>PERONISMO " & FORMAT(DIVIDE(p, p + d), "0.0%") & "</text>"
			    & "<text x='982' y='76' text-anchor='end' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>LLA + PRO " & FORMAT(DIVIDE(d, p + d), "0.0%") & "</text>"
			    & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 03 · Pronóstico 2027
		dataCategory: ImageUrl

	measure 'SVG barra elección' =
			VAR p = [% Peronismo]
			VAR d = [% Derecha]
			VAR w = INT(1000 * DIVIDE(p, p + d))
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 120'>"
			    & "<text x='500' y='18' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#1D1631'>50 %</text>"
			    & "<rect x='0' y='30' width='" & w & "' height='70' fill='#2F80ED'><animate attributeName='width' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<rect x='" & w & "' y='30' width='" & (1000 - w) & "' height='70' fill='#6A1B9A'><animate attributeName='x' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/><animate attributeName='width' from='500' to='" & (1000 - w) & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<line x1='500' y1='24' x2='500' y2='108' stroke='#1D1631' stroke-width='3' stroke-dasharray='7 5'/>"
			    & "<text x='18' y='76' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>PERONISMO " & FORMAT(DIVIDE(p, p + d), "0.0%") & "</text>"
			    & "<text x='982' y='76' text-anchor='end' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>LLA + PRO " & FORMAT(DIVIDE(d, p + d), "0.0%") & "</text>"
			    & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 01 · Votos
		dataCategory: ImageUrl

	measure Diputados =
			SUM(secciones[diputados])
		formatString: 0
		displayFolder: 05 · Secciones

	measure Senadores =
			SUM(secciones[senadores])
		formatString: 0
		displayFolder: 05 · Secciones

	measure 'SVG mapa secciones' =
			VAR filas = ADDCOLUMNS(ALL(secciones[seccion], secciones[path_p], secciones[cx], secciones[cy], secciones[lx], secciones[ly], secciones[fuera]),
			    "c", [Color ganador], "p", [% Peronismo], "d", [% Derecha])
			VAR formas = CONCATENATEX(filas, "<path d='" & secciones[path_p] & "' fill='" & [c] & "' fill-opacity='0.88' stroke='#FFFFFF' stroke-width='2.5' stroke-linejoin='round'/>", "")
			VAR bordes = "<g fill='none' stroke='#FFFFFF' stroke-width='0.5' stroke-opacity='0.75'>" & CONCATENATEX(FILTER(ALL(dim_municipio[svg_prov]), dim_municipio[svg_prov] <> ""), "<path d='" & dim_municipio[svg_prov] & "'/>", "") & "</g>"
			VAR rot = CONCATENATEX(filas,
			    IF(secciones[fuera] = 1, "<line x1='" & secciones[cx] & "' y1='" & secciones[cy] & "' x2='" & (secciones[lx] - 30) & "' y2='" & (secciones[ly] - 6) & "' stroke='#1D1631' stroke-width='1'/>", "")
			    & "<text x='" & secciones[lx] & "' y='" & secciones[ly] & "' text-anchor='middle' font-family='Segoe UI' font-size='20' font-weight='800' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>" & secciones[seccion] & "</text>"
			    & "<text x='" & secciones[lx] & "' y='" & (secciones[ly] + 17) & "' text-anchor='middle' font-family='Segoe UI' font-size='12' font-weight='600' fill='#1D1631' stroke='#FFFFFF' stroke-width='3' stroke-opacity='0.9' paint-order='stroke' stroke-linejoin='round'>P " & FORMAT([p], "0%") & " · L " & FORMAT([d], "0%") & "</text>", "")
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 894'><g><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & formas & bordes & "</g><g><animate attributeName='opacity' values='0;0;1' keyTimes='0;0.5;1' dur='1.4s' fill='freeze'/>" & rot & "</g>"
			    & "<text x='392' y='700' font-family='Segoe UI' font-size='13' fill='#6B6480'>P = peronismo · L = LLA + PRO</text>"
			    & "<text x='392' y='718' font-family='Segoe UI' font-size='13' fill='#6B6480'>Color: quién ganó la sección</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 05 · Secciones
		dataCategory: ImageUrl

	measure 'Circuitos con datos' =
			COUNTROWS(FILTER(circuitos, NOT ISBLANK(circuitos[per_D2025])))
		formatString: #,0
		displayFolder: 06 · Circuitos

	measure 'Votos circuitos' =
			SUM(circuitos[votos_D2025])
		formatString: #,0
		displayFolder: 06 · Circuitos

	measure '% peronismo circuitos' =
			DIVIDE(SUMX(circuitos, circuitos[per_D2025] * circuitos[votos_D2025]), SUM(circuitos[votos_D2025])) / 100
		formatString: 0.0%
		displayFolder: 06 · Circuitos

	measure '% LLA+PRO circuitos' =
			DIVIDE(SUMX(circuitos, circuitos[der_D2025] * circuitos[votos_D2025]), SUM(circuitos[votos_D2025])) / 100
		formatString: 0.0%
		displayFolder: 06 · Circuitos

	measure Lon =
			AVERAGE(circuitos[lon])
		formatString: 0.000
		displayFolder: 06 · Circuitos

	measure Lat =
			AVERAGE(circuitos[lat])
		formatString: 0.000
		displayFolder: 06 · Circuitos

	measure 'Título mapa fino' =
			SELECTEDVALUE(metrica_circuito[metrica], "Ganador 2025") & "  ·  circuito por circuito (1.146 circuitos electorales)"
		displayFolder: 06 · Circuitos

	measure 'SVG mapa fino' =
			VAR idc = SELECTEDVALUE(metrica_circuito[id], 1)
			VAR modo = SWITCH(idc, 1, 4, 2, 1, 3, 1, 4, 3, 5, 3, 6, 1, 7, 1, 8, 1, BLANK())
			VAR base = SWITCH(idc, 1, "#2F80ED", 2, "#2F80ED", 3, "#6A1B9A", 4, "#2F80ED", 5, "#2F80ED", 6, "#5B3F99", 7, "#C62828", 8, "#E0A526", BLANK())
			VAR neg = SWITCH(idc, 1, "#6A1B9A", 4, "#6A1B9A", 5, "#C62828", BLANK())
			VAR fmtc = SWITCH(idc, 1, "+0;-0;0", 2, "0%", 3, "0%", 4, "+0;-0;0", 5, "+0;-0;0", 6, "0%", 7, "0.0%", 8, "0.0%", BLANK())
			VAR selc = VALUES(circuitos[circuito])
			VAR todos = ADDCOLUMNS(ALL(circuitos[circuito], circuitos[per_D2025], circuitos[der_D2025], circuitos[part_D2025], circuitos[per_G2023],
			        circuitos[nbi], circuitos[bp]), "v", IF(circuitos[circuito] IN selc, SWITCH(idc, 1, circuitos[per_D2025] - circuitos[der_D2025], 2, circuitos[per_D2025] / 100, 3, circuitos[der_D2025] / 100, 4, circuitos[per_D2025] - circuitos[der_D2025], 5, IF(ISBLANK(circuitos[per_G2023]) || ISBLANK(circuitos[per_D2025]), BLANK(), circuitos[per_D2025] - circuitos[per_G2023]), 6, circuitos[part_D2025] / 100, 7, circuitos[nbi] / 100, 8, circuitos[bp] / 100)))
			VAR lo = MINX(todos, [v])
			VAR hi = MAXX(todos, [v])
			VAR ma = MAXX(todos, ABS([v]))
			VAR prov =
			VAR filas = ADDCOLUMNS(FILTER(ALL(circuitos[circuito], circuitos[path_p], circuitos[per_D2025], circuitos[der_D2025], circuitos[part_D2025],
			        circuitos[per_G2023], circuitos[nbi], circuitos[bp]), circuitos[path_p] <> ""), "v", IF(circuitos[circuito] IN selc, SWITCH(idc, 1, circuitos[per_D2025] - circuitos[der_D2025], 2, circuitos[per_D2025] / 100, 3, circuitos[der_D2025] / 100, 4, circuitos[per_D2025] - circuitos[der_D2025], 5, IF(ISBLANK(circuitos[per_G2023]) || ISBLANK(circuitos[per_D2025]), BLANK(), circuitos[per_D2025] - circuitos[per_G2023]), 6, circuitos[part_D2025] / 100, 7, circuitos[nbi] / 100, 8, circuitos[bp] / 100)))
			RETURN "<g stroke='#FFFFFF' stroke-width='0.25' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 4, IF(v >= 0, base, neg), modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 4, 92, INT(14 + 85 * t))
			    RETURN "<path d='" & circuitos[path_p] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "") & "</g>"
			VAR conu =
			VAR filas = ADDCOLUMNS(FILTER(ALL(circuitos[circuito], circuitos[path_c], circuitos[per_D2025], circuitos[der_D2025], circuitos[part_D2025],
			        circuitos[per_G2023], circuitos[nbi], circuitos[bp]), circuitos[path_c] <> ""), "v", IF(circuitos[circuito] IN selc, SWITCH(idc, 1, circuitos[per_D2025] - circuitos[der_D2025], 2, circuitos[per_D2025] / 100, 3, circuitos[der_D2025] / 100, 4, circuitos[per_D2025] - circuitos[der_D2025], 5, IF(ISBLANK(circuitos[per_G2023]) || ISBLANK(circuitos[per_D2025]), BLANK(), circuitos[per_D2025] - circuitos[per_G2023]), 6, circuitos[part_D2025] / 100, 7, circuitos[nbi] / 100, 8, circuitos[bp] / 100)))
			RETURN "<g stroke='#FFFFFF' stroke-width='0.5' stroke-linejoin='round'><animate attributeName='opacity' values='0;1' dur='0.8s' fill='freeze'/>" & CONCATENATEX(filas,
			    VAR v = [v]
			    VAR t = IF(modo = 3, DIVIDE(ABS(v), ma), DIVIDE(v - lo, hi - lo, 1))
			    VAR col = SWITCH(TRUE(), ISBLANK(v), "#E4DFEE", modo = 4, IF(v >= 0, base, neg), modo = 3 && v < 0, neg, base)
			    VAR o = IF(ISBLANK(v) || modo = 4, 92, INT(14 + 85 * t))
			    RETURN "<path d='" & circuitos[path_c] & "' fill='" & col & "' fill-opacity='0." & FORMAT(o, "00") & "'/>", "") & "</g>"
			VAR bordes = "<g fill='none' stroke='#1D1631' stroke-opacity='0.45' stroke-width='0.7'>" & CONCATENATEX(FILTER(ALL(dim_municipio[svg_prov]), dim_municipio[svg_prov] <> ""), "<path d='" & dim_municipio[svg_prov] & "'/>", "") & "</g>"
			VAR bordes_c = "<g fill='none' stroke='#1D1631' stroke-opacity='0.55' stroke-width='1.2'>" & CONCATENATEX(FILTER(ALL(dim_municipio[svg_conu]), dim_municipio[svg_conu] <> ""), "<path d='" & dim_municipio[svg_conu] & "'/>", "") & "</g>"
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1240 894'>" & prov & bordes
			    & "<g transform='translate(0 640)'>" & IF(modo = 4, "<rect x='392' y='4' width='20' height='16' rx='3' fill='#2F80ED'/><text x='420' y='17' font-family='Segoe UI' font-size='13' fill='#1D1631'>Ganó el peronismo</text><rect x='392' y='28' width='20' height='16' rx='3' fill='#6A1B9A'/><text x='420' y='41' font-family='Segoe UI' font-size='13' fill='#1D1631'>Ganó LLA + PRO</text>", "<rect x='392' y='4' width='170' height='16' fill='" & IF(modo = 3, neg, base) & "' fill-opacity='0.25'/><rect x='477' y='4' width='85' height='16' fill='" & base & "'/><text x='392' y='38' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, -ma, lo), fmtc) & "</text><text x='562' y='38' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#1D1631'>" & FORMAT(IF(modo = 3, ma, hi), fmtc) & "</text>") & "</g>"
			    & "<g transform='translate(640 44)'><rect x='0' y='0' width='600' height='759' rx='10' fill='#FFFFFF' stroke='#E4DFEE' stroke-width='2'/>" & conu & bordes_c & "</g>"
			    & "<text x='640' y='30' font-family='Segoe UI' font-size='18' font-weight='700' fill='#5B3F99'>Conurbano y Gran La Plata · circuito por circuito</text></svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 06 · Circuitos
		dataCategory: ImageUrl

	measure 'Elección base elegida' =
			SELECTEDVALUE(eleccion_base[Elección base], "Gobernador 2023")
		displayFolder: 07 · Corrimientos

	measure '% Peronismo base' =
			VAR e = SELECTEDVALUE(eleccion_base[eleccion], "G2023") RETURN CALCULATE([% Peronismo], REMOVEFILTERS(dim_eleccion), dim_eleccion[eleccion] = e)
		formatString: 0.0%
		displayFolder: 07 · Corrimientos

	measure '% Derecha base' =
			VAR e = SELECTEDVALUE(eleccion_base[eleccion], "G2023") RETURN CALCULATE([% Derecha], REMOVEFILTERS(dim_eleccion), dim_eleccion[eleccion] = e)
		formatString: 0.0%
		displayFolder: 07 · Corrimientos

	measure 'Corrimiento peronismo (pts)' =
			([% Peronismo] - [% Peronismo base]) * 100
		formatString: +0.0;-0.0;0
		displayFolder: 07 · Corrimientos

	measure 'Corrimiento LLA/PRO (pts)' =
			([% Derecha] - [% Derecha base]) * 100
		formatString: +0.0;-0.0;0
		displayFolder: 07 · Corrimientos

	measure 'Color corrimiento' =
			IF([Corrimiento peronismo (pts)] >= 0, "#2F80ED", "#C62828")
		displayFolder: 04 · Textos y colores

	measure 'Municipios donde creció el peronismo' =
			COUNTROWS(FILTER(VALUES(dim_municipio[cod_indec]), [Corrimiento peronismo (pts)] > 0))
		formatString: 0
		displayFolder: 07 · Corrimientos

	measure 'Municipios donde cayó el peronismo' =
			COUNTROWS(FILTER(VALUES(dim_municipio[cod_indec]), [Corrimiento peronismo (pts)] < 0))
		formatString: 0
		displayFolder: 07 · Corrimientos

	measure 'Margen absoluto (pts)' =
			ABS([Margen P-D (pts)])
		formatString: 0.0
		displayFolder: 08 · Dónde se decide

	measure 'Votos para dar vuelta' =
			ABS([Diferencia de votos]) / 2
		formatString: #,0
		displayFolder: 08 · Dónde se decide

	measure 'Municipios bisagra' =
			COUNTROWS(FILTER(VALUES(dim_municipio[cod_indec]), ABS([Margen P-D (pts)]) < 5))
		formatString: 0
		displayFolder: 08 · Dónde se decide

	measure 'Electores en bisagras' =
			SUMX(FILTER(VALUES(dim_municipio[cod_indec]), ABS([Margen P-D (pts)]) < 5), [Electores])
		formatString: #,0
		displayFolder: 08 · Dónde se decide

	measure '% del padrón en bisagras' =
			DIVIDE([Electores en bisagras], [Electores provincia])
		formatString: 0.0%
		displayFolder: 08 · Dónde se decide

	measure 'Color intendente' =
			SELECTEDVALUE(dim_municipio[color_fuerza], "#9A93AD")
		displayFolder: 04 · Textos y colores

	measure 'Fuerza del intendente' =
			SELECTEDVALUE(dim_municipio[fuerza_intendente], "—")
		displayFolder: 09 · Intendentes

	measure 'Color reelección' =
			SELECTEDVALUE(dim_municipio[color_reeleccion], "#9A93AD")
		displayFolder: 04 · Textos y colores

	measure 'Reelección 2027' =
			SELECTEDVALUE(dim_municipio[reeleccion_2027], "—")
		displayFolder: 09 · Intendentes

	measure Uno =
			IF(HASONEVALUE(dim_municipio[cod_indec]), 1)
		formatString: 0
		displayFolder: 09 · Intendentes

	measure 'Intendentes de Fuerza Patria' =
			CALCULATE([Municipios], dim_municipio[fuerza_intendente] = "Fuerza Patria")
		formatString: 0
		displayFolder: 09 · Intendentes

	measure 'Pueden reelegir' =
			CALCULATE([Municipios], dim_municipio[reeleccion_2027] = "Puede ir por la reelección")
		formatString: 0
		displayFolder: 09 · Intendentes

	measure 'No pueden reelegir' =
			CALCULATE([Municipios], dim_municipio[reeleccion_2027] = "No puede: cumple su segundo mandato")
		formatString: 0
		displayFolder: 09 · Intendentes

	measure Interinos =
			CALCULATE([Municipios], dim_municipio[reeleccion_2027] = "Intendente interino")
		formatString: 0
		displayFolder: 09 · Intendentes

	measure '% peronismo esperado 2027' =
			IF(ISFILTERED(fact_motor_2027[escenario]), AVERAGE(fact_motor_2027[pct_peronismo]), CALCULATE(AVERAGE(fact_motor_2027[pct_peronismo]), fact_motor_2027[escenario_clave] = "A")) / 100
		formatString: 0.0%
		displayFolder: 03 · Pronóstico 2027

	measure 'Sim votos peronismo' =
			SUMX(VALUES(dim_municipio[cod_indec]), VAR T = CALCULATE([Votos], REMOVEFILTERS(dim_espacio)) VAR P = [Votos peronismo] VAR D = [Votos derecha] RETURN MAX(0, P + T * (SELECTEDVALUE(sim_swing[Corrimiento uniforme (pts)], 0) / 100) + (T - P - D) * (SELECTEDVALUE(sim_terceros[Terceros que van al peronismo (%)], 0) / 100)))
		formatString: #,0
		displayFolder: 10 · Simulador

	measure 'Sim votos LLA+PRO' =
			SUMX(VALUES(dim_municipio[cod_indec]), VAR T = CALCULATE([Votos], REMOVEFILTERS(dim_espacio)) VAR D = [Votos derecha] RETURN MAX(0, D * (1 - (SELECTEDVALUE(sim_division[LLA + PRO que se va a otra lista (%)], 0) / 100)) - T * (SELECTEDVALUE(sim_swing[Corrimiento uniforme (pts)], 0) / 100)))
		formatString: #,0
		displayFolder: 10 · Simulador

	measure 'Sim votos total' =
			SUMX(VALUES(dim_municipio[cod_indec]), CALCULATE([Votos], REMOVEFILTERS(dim_espacio)))
		formatString: #,0
		displayFolder: 10 · Simulador

	measure 'Sim % peronismo' =
			DIVIDE([Sim votos peronismo], [Sim votos total])
		formatString: 0.0%
		displayFolder: 10 · Simulador

	measure 'Sim % LLA+PRO' =
			DIVIDE([Sim votos LLA+PRO], [Sim votos total])
		formatString: 0.0%
		displayFolder: 10 · Simulador

	measure 'Sim margen (pts)' =
			DIVIDE([Sim votos peronismo] - [Sim votos LLA+PRO], [Sim votos total]) * 100
		formatString: +0.0;-0.0;0
		displayFolder: 10 · Simulador

	measure 'Sim ganador' =
			IF([Sim votos peronismo] >= [Sim votos LLA+PRO], "Peronismo", "LLA + PRO")
		displayFolder: 10 · Simulador

	measure 'Sim municipios peronistas' =
			COUNTROWS(FILTER(VALUES(dim_municipio[cod_indec]), [Sim votos peronismo] > [Sim votos LLA+PRO]))
		formatString: 0
		displayFolder: 10 · Simulador

	measure 'Sim municipios que cambian' =
			COUNTROWS(FILTER(VALUES(dim_municipio[cod_indec]), ([Sim votos peronismo] > [Sim votos LLA+PRO]) <> ([Votos peronismo] > [Votos derecha])))
		formatString: 0
		displayFolder: 10 · Simulador

	measure 'Color sim' =
			IF([Sim margen (pts)] >= 0, "#2F80ED", "#6A1B9A")
		displayFolder: 04 · Textos y colores

	measure 'SVG barra simulación' =
			VAR p = [Sim votos peronismo]
			VAR d = [Sim votos LLA+PRO]
			VAR w = INT(1000 * DIVIDE(p, p + d))
			VAR svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 120'>"
			    & "<text x='500' y='18' text-anchor='middle' font-family='Segoe UI' font-size='15' fill='#1D1631'>50 %</text>"
			    & "<rect x='0' y='30' width='" & w & "' height='70' fill='#2F80ED'><animate attributeName='width' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<rect x='" & w & "' y='30' width='" & (1000 - w) & "' height='70' fill='#6A1B9A'><animate attributeName='x' from='500' to='" & w & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/><animate attributeName='width' from='500' to='" & (1000 - w) & "' dur='1.2s' calcMode='spline' keySplines='0.2 0.8 0.2 1' keyTimes='0;1'/></rect>"
			    & "<line x1='500' y1='24' x2='500' y2='108' stroke='#1D1631' stroke-width='3' stroke-dasharray='7 5'/>"
			    & "<text x='18' y='76' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>PERONISMO " & FORMAT(DIVIDE(p, p + d), "0.0%") & "</text>"
			    & "<text x='982' y='76' text-anchor='end' font-family='Segoe UI' font-size='30' font-weight='700' fill='#FFFFFF'>LLA + PRO " & FORMAT(DIVIDE(d, p + d), "0.0%") & "</text>"
			    & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(svg, "%", "%25"), "#", "%23")
		displayFolder: 10 · Simulador
		dataCategory: ImageUrl

	column Valor
		dataType: string
		summarizeBy: none
		sourceColumn: [Value]
		isHidden

	partition Medidas = calculated
		mode: import
		source =
				{BLANK()}

