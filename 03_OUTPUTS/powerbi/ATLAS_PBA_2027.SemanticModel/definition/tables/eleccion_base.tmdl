table eleccion_base

	column eleccion
		dataType: string
		summarizeBy: none
		sourceColumn: [eleccion]
		isHidden

	column 'Elección base'
		dataType: string
		summarizeBy: none
		sourceColumn: [Elección base]
		sortByColumn: orden

	column orden
		dataType: int64
		summarizeBy: none
		sourceColumn: [orden]
		isHidden

	partition eleccion_base = calculated
		mode: import
		source =
				SELECTCOLUMNS(dim_eleccion, "eleccion", dim_eleccion[eleccion], "Elección base", dim_eleccion[rotulo], "orden", dim_eleccion[orden])

