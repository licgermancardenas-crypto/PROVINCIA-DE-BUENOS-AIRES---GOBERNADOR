table dim_espacio

	column espacio
		dataType: string
		summarizeBy: none
		sourceColumn: espacio
		isKey

	column espacio_nombre
		dataType: string
		summarizeBy: none
		sourceColumn: espacio_nombre
		sortByColumn: orden

	column color
		dataType: string
		summarizeBy: none
		sourceColumn: color
		isHidden

	column logo_url
		dataType: string
		summarizeBy: none
		sourceColumn: logo_url
		isHidden

	column orden
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: orden
		isHidden

	partition dim_espacio = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_espacio.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"espacio", type text}, {"espacio_nombre", type text}, {"color", type text}, {"logo_url", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

