table metrica_mapa

	column id
		dataType: int64
		summarizeBy: none
		sourceColumn: [id]
		isHidden

	column metrica
		dataType: string
		summarizeBy: none
		sourceColumn: [metrica]
		sortByColumn: id

	partition metrica_mapa = calculated
		mode: import
		source =
				DATATABLE("id", INTEGER, "metrica", STRING, {
				    {1, "Ganador de la elección"},
				    {2, "% del peronismo"},
				    {3, "% de LLA y PRO"},
				    {4, "Margen peronismo − LLA/PRO (pts)"},
				    {5, "Participación"},
				    {6, "Cambio del peronismo vs. Gobernador 2023 (pts)"},
				    {7, "Pronóstico 2027 · probabilidad de que gane el peronismo"},
				    {8, "Hogares con NBI (censo 2022)"},
				    {9, "Hogares en barrios populares"},
				    {10, "Electores"},
				    {11, "Fuerza del intendente (oct. 2026)"},
				    {12, "Corrimiento del peronismo vs. elección base (pts)"},
				    {13, "Reelección del intendente en 2027"}
				})

