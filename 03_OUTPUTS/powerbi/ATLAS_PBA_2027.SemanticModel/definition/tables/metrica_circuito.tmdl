table metrica_circuito

	column id
		dataType: int64
		summarizeBy: none
		sourceColumn: [id]
		isHidden

	column metrica
		dataType: string
		summarizeBy: none
		sourceColumn: [metrica]
		sortByColumn: id

	partition metrica_circuito = calculated
		mode: import
		source =
				DATATABLE("id", INTEGER, "metrica", STRING, {
				    {1, "Ganador 2025 (peronismo o LLA + PRO)"},
				    {2, "% del peronismo 2025"},
				    {3, "% de LLA + PRO 2025"},
				    {4, "Margen peronismo − LLA/PRO 2025 (pts)"},
				    {5, "Cambio del peronismo, Gobernador 2023 → Diputados 2025 (pts)"},
				    {6, "Participación 2025"},
				    {7, "Hogares con NBI (censo 2022)"},
				    {8, "Hogares en barrios populares"}
				})

